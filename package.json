{
  "name": "eng-backend",
  "version": "1.0.0",
  "main": "app.ts",
  "scripts": {
    "dev": "concurrently \"ts-node-dev --respawn --transpile-only src/server.ts\" \"npm run stripe\" \"npm run docker:up\"",
    "start": "node dist/server.js",
    "start:cluster": "npm run build && pm2 start ecosystem.config.js --env production",
    "reload:cluster": "npm run build && pm2 reload ecosystem.config.js --env production",
    "build": "tsc && npx cpx \"src/views/**/*\" dist/views",
    "test": "echo \"Error: no test specified\" && exit 1",
    "queue:stats": "ts-node src/scripts/queueStats.ts",
    "queue:clean": "ts-node src/scripts/cleanQueues.ts",
    "migrate:leagues": "node scripts/migrateLeagueAgeGroups.js",
    "stripe": "stripe listen --forward-to=https://rakibur5005.binarybards.online/api/v1/payment/webhook"
  },
  "author": "Md Rakibur Rahman",
  "license": "ISC",
  "description": "Eng-Backend",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/redis": "^4.0.10",
    "npm-check-updates": "^20.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
